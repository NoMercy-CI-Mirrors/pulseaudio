msgstr "Nederīga ierakstīšanas straumes indeksa norāde"

#: src/utils/pactl.c:3162
msgid "You have to specify at least an object path and a message name"
msgstr "Jānorāda vismaz objekta ceļš un ziņojuma nosaukums"

#: src/utils/pactl.c:3172
msgid ""
"Excess arguments given, they will be ignored. Note that all message parameters must be "
"given as a single string."
msgstr ""
"Norādīti lieki argumenti, tie tiks ignorēti. Ņemiet vērā, ka visi ziņojuma "
"parametri jānorāda kā viena virkne."

#: src/utils/pactl.c:3182
msgid ""
"You have to specify a sink index and a semicolon-separated list of supported formats"
msgstr ""
"Jānorāda izvades ierīces indekss un ar semikoliem atdalīts atbalstīto "
"formātu saraksts"

#: src/utils/pactl.c:3194
msgid "You have to specify a card name/index, a port name and a latency offset"
msgstr "Jānorāda kartes nosaukums/indekss, porta nosaukums un latentuma nobīde"

#: src/utils/pactl.c:3201
msgid "Could not parse latency offset"
msgstr "Nevarēja parsēt latentuma nobīdi"

#: src/utils/pactl.c:3213
msgid "No valid command specified."
msgstr "Nav norādīta derīga komanda."

