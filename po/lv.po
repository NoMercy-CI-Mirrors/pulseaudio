#: src/utils/pax11publish.c:58
#, c-format
msgid ""
"%s [-D display] [-S server] [-O sink] [-I source] [-c file]  [-d|-e|-i|-r]\n"
"\n"
" -d    Show current PulseAudio data attached to X11 display (default)\n"
" -e    Export local PulseAudio data to X11 display\n"
" -i    Import PulseAudio data from X11 display to local environment variables and "
"cookie file.\n"
" -r    Remove PulseAudio data from X11 display\n"
msgstr ""
"%s [-D displejs] [-S serveris] [-O izvades_ierīce] [-I avots] [-c fails]  [-"
"d|-e|-i|-r]\n"
"\n"
" -d    Rādīt pašreizējos PulseAudio datus, kas piesaistīti X11 displejam "
"(noklusējums)\n"
" -e    Eksportēt lokālos PulseAudio datus uz X11 displeju\n"
" -i    Importēt PulseAudio datus no X11 displeja lokālajos vides mainīgajos "
"un sīkdatnes failā.\n"
" -r    Noņemt PulseAudio datus no X11 displeja\n"

