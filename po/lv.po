#: src/utils/pacat.c:676
#, c-format
msgid ""
"%s [options]\n"
"%s\n"
"\n"
"  -h, --help                            Show this help\n"
"      --version                         Show version\n"
"\n"
"  -r, --record                          Create a connection for recording\n"
"  -p, --playback                        Create a connection for playback\n"
"\n"
"  -v, --verbose                         Enable verbose operations\n"
"\n"
"  -s, --server=SERVER                   The name of the server to connect to\n"
"  -d, --device=DEVICE                   The name of the sink/source to connect to. The "
"special names @DEFAULT_SINK@, @DEFAULT_SOURCE@ and @DEFAULT_MONITOR@ can be used to "
"specify the default sink, source and monitor respectively.\n"
"  -n, --client-name=NAME                How to call this client on the server\n"
"      --stream-name=NAME                How to call this stream on the server\n"
"      --volume=VOLUME                   Specify the initial (linear) volume in range "
"0...65536\n"
"      --rate=SAMPLERATE                 The sample rate in Hz (defaults to 44100)\n"
"      --format=SAMPLEFORMAT             The sample format, see\n"
"                                        https://www.freedesktop.org/wiki/Software/"
"PulseAudio/Documentation/User/SupportedAudioFormats/\n"
"                                        for possible values (defaults to s16ne)\n"
"      --channels=CHANNELS               The number of channels, 1 for mono, 2 for "
"stereo\n"
"                                        (defaults to 2)\n"
"      --channel-map=CHANNELMAP          Channel map to use instead of the default\n"
"      --fix-format                      Take the sample format from the sink/source the "
"stream is\n"
"                                        being connected to.\n"
"      --fix-rate                        Take the sampling rate from the sink/source the "
"stream is\n"
"                                        being connected to.\n"
"      --fix-channels                    Take the number of channels and the channel "
"map\n"
"                                        from the sink/source the stream is being "
"connected to.\n"
"      --no-remix                        Don't upmix or downmix channels.\n"
"      --no-remap                        Map channels by index instead of name.\n"
"      --latency=BYTES                   Request the specified latency in bytes.\n"
"      --process-time=BYTES              Request the specified process time per request "
"in bytes.\n"
"      --latency-msec=MSEC               Request the specified latency in msec.\n"
"      --process-time-msec=MSEC          Request the specified process time per request "
"in msec.\n"
"      --property=PROPERTY=VALUE         Set the specified property to the specified "
"value.\n"
"      --raw                             Record/play raw PCM data.\n"
"      --passthrough                     Passthrough data.\n"
"      --file-format[=FFORMAT]           Record/play formatted PCM data.\n"
"      --list-file-formats               List available file formats.\n"
"      --monitor-stream=INDEX            Record from the sink input with index INDEX.\n"
msgstr ""
"%s [opcijas]\n"
"%s\n"
"\n"
"  -h, --help                            Rādīt šo palīdzību\n"
"      --version                         Rādīt versiju\n"
"\n"
"  -r, --record                          Izveidot savienojumu ierakstīšanai\n"
"  -p, --playback                        Izveidot savienojumu atskaņošanai\n"
"\n"
"  -v, --verbose                         Iespējot detalizētu darbību\n"
"\n"
"  -s, --server=SERVERIS                 Servera nosaukums, ar kuru "
"savienoties\n"
"  -d, --device=IERĪCE                   Izvades ierīces/avota nosaukums, ar "
"ko savienoties. Speciālos nosaukumus @DEFAULT_SINK@, @DEFAULT_SOURCE@ un "
"@DEFAULT_MONITOR@ var izmantot, lai norādītu attiecīgi noklusējuma izvades "
"ierīci, avotu un monitoru.\n"
"  -n, --client-name=NOSAUKUMS           Kā šo klientu saukt serverī\n"
"      --stream-name=NOSAUKUMS           Kā šo straumi saukt serverī\n"
"      --volume=SKAĻUMS                  Norādīt sākotnējo (lineāro) skaļumu "
"robežās 0...65536\n"
"      --rate=FREKVENCE                  Diskretizācijas frekvence Hz "
"(noklusējums: 44100)\n"
"      --format=PARAUGU_FORMĀTS          Paraugu formāts; iespējamās vērtības "
"skatiet\n"
"                                        https://www.freedesktop.org/wiki/"
"Software/PulseAudio/Documentation/User/SupportedAudioFormats/\n"
"                                        (noklusējums: s16ne)\n"
"      --channels=KANĀLI                 Kanālu skaits: 1 — mono, 2 — stereo\n"
"                                        (noklusējums: 2)\n"
"      --channel-map=KANĀLU_KARTE        Noklusējuma vietā izmantojamā kanālu "
"karte\n"
"      --fix-format                      Ņemt paraugu formātu no izvades "
"ierīces/avota, ar ko\n"
"                                        straume tiek savienota.\n"
"      --fix-rate                        Ņemt diskretizācijas frekvenci no "
"izvades ierīces/avota, ar ko\n"
"                                        straume tiek savienota.\n"
"      --fix-channels                    Ņemt kanālu skaitu un kanālu karti "
"no izvades\n"
"                                        ierīces/avota, ar ko straume tiek "
"savienota.\n"
"      --no-remix                        Nepalielināt un nesamazināt kanālu "
"skaitu, miksējot.\n"
"      --no-remap                        Kartēt kanālus pēc indeksa, nevis "
"nosaukuma.\n"
"      --latency=BAITI                   Pieprasīt norādīto latentumu "
"baitos.\n"
"      --process-time=BAITI              Pieprasīt norādīto apstrādes laiku "
"vienam pieprasījumam baitos.\n"
"      --latency-msec=MS                 Pieprasīt norādīto latentumu "
"milisekundēs.\n"
"      --process-time-msec=MS            Pieprasīt norādīto apstrādes laiku "
"vienam pieprasījumam milisekundēs.\n"
"      --property=ĪPAŠĪBA=VĒRTĪBA        Iestatīt norādīto īpašību uz "
"norādīto vērtību.\n"
"      --raw                             Ierakstīt/atskaņot neapstrādātus PCM "
"datus.\n"
"      --passthrough                     Nodot datus tieši.\n"
"      --file-format[=FFORMĀTS]          Ierakstīt/atskaņot formatētus PCM "
"datus.\n"
"      --list-file-formats               Uzskaitīt pieejamos failu formātus.\n"
"      --monitor-stream=INDEKSS          Ierakstīt no atskaņošanas straumes "
"ar indeksu INDEKSS.\n"

